rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User data is strictly isolated per authenticated UID
    match /users/{userId}/{allUserPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Public assets can be read by any client, written by authenticated users or backend
    match /assets/{assetId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Shared campaigns can be read publicly
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
