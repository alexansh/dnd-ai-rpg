rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Assets are publicly readable (portraits, scene backgrounds), writable by authenticated users
    match /assets/{assetId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User-specific private uploads
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
