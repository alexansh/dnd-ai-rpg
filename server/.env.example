# ==============================================================================
# The Wayward Flagon - Server Environment Configuration
# ==============================================================================
# NOTE: The game works 100% out of the box without any of these variables!
# If left empty, the server automatically runs in Local Simulation Mode:
#   - Procedural Smart Simulation DM & pre-bundled story arcs
#   - Local file-based Firestore mock (.data/firestore/)
#   - Local disk asset cache (.data/assets/)
# ==============================================================================

# Server Port (Default: 3001)
PORT=3001

# ------------------------------------------------------------------------------
# 1. Google Gemini AI (Optional - unlocks live generative AI DM & AI World Forge)
# Get a free key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK (Optional - unlocks cloud cross-device saves & storage)
# Obtain from: Firebase Console -> Project Settings -> Service Accounts -> Generate Private Key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
